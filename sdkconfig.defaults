# Use 4MB flash (board has 8MB, 4MB is conservative and well-supported)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Use custom partition table with 2MB app partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Enable TinyUSB CDC ACM used by the USB logging and command interface.
CONFIG_TINYUSB_CDC_ENABLED=y

# Enable Certificate Bundle with custom Google & GlobalSign root certificates
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certificates/r1.pem"

# Optimize Mbed TLS memory footprint to prevent out-of-memory (0x4290) during handshakes
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# Reduce WiFi buffer memory consumption to free up internal SRAM for TLS handshakes
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_MGMT_SBUF_NUM=16
